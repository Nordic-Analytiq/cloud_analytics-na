y (native to Databricks tables).\n-- The ref() call below creates a dependency on the staging model.\n\n\nwith events as (\n\n    select * from `format_demo_catalog`.`format_demo_staging`.`stg_events`\n\n),\n\naggregated as (\n\n    select\n        city,\n        count(*)           as event_count,\n        min(event_date)    as first_event,\n        max(event_date)    as last_event\n    from events\n\n    \n    -- On incremental runs, only process rows newer than what's already loaded\n    where event_date > (select coalesce(max(last_event), '1900-01-01') from `format_demo_catalog`.`format_demo_marts`.`fct_events_by_city`)\n    \n\n    group by city\n\n)\n\nselect * from aggregated", "relation_name": "`format_demo_catalog`.`format_demo_marts`.`fct_events_by_city`", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-18T19:58:04.526289Z", "completed_at": "2026-11-18T19:58:04.540058Z"}, {"name": "execute", "started_at": "2026-11-18T19:58:04.541022Z", "completed_at": "2026-11-18T19:58:04.541038Z"}], "thread_id": "Thread-118 (worker)", "execution_time": 0.019686460494995117, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.analytics_demos.accepted_values_stg_events_city__STOCKHOLM__GOTHENBURG__MALMO.9fd4bde13e", "compiled": true, "compiled_code": "\n    \n    \n\nwith all_values as (\n\n    select\n        city as value_field,\n        count(*) as n_records\n\n    from `format_demo_catalog`.`format_demo_staging`.`stg_events`\n    group by city\n\n)\n\nselect *\nfrom all_values\nwhere value_field not in (\n    'STOCKHOLM','GOTHENBURG','MALMO'\n)\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-18T19:58:04.545822Z", "completed_at": "2026-11-18T19:58:04.557470Z"}, {"name": "execute", "started_at": "2026-11-18T19:58:04.558253Z", "completed_at": "2026-11-18T19:58:04.5